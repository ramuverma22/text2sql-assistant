# Copy this file to .env and fill it in. Never commit .env to GitHub.
# Any OpenAI-compatible API works. Uncomment ONE provider block.

# --- OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=<a model name from your provider's model list>

# --- Groq (has a free tier) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=<a Groq model name>

# --- Google Gemini (OpenAI-compatible endpoint, has a free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=...
# LLM_MODEL=<a Gemini model name>

# --- Ollama (runs locally, free) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=<a model you have pulled, e.g. a Qwen or Llama coder model>

DB_PATH=data/olist.db
